stateDiagram-v2
    %% machine HttpParser
    state RequestLine {
        Method
        Target
        Version
        [*] --> Method
        Method --> Target
        Target --> Version
    }
    state Headers {
        LineStart
        Name
        Value
        ValueLf
        BlockLf
        [*] --> LineStart
        LineStart --> BlockLf
        LineStart --> Name
        Name --> Value
        Value --> ValueLf
        ValueLf --> LineStart
    }
    Body
    Error
    [*] --> RequestLine
    Error --> [*]
    Method --> Error
    Target --> Error
    Version --> Headers : VersionStep#58;#58;Complete
    Version --> Error : VersionStep#58;#58;Unsupported
    RequestLine --> Error
    Value --> Error
    BlockLf --> RequestLine
    BlockLf --> Body
    Headers --> Error
    Body --> RequestLine
