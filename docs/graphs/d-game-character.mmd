stateDiagram-v2
    %% machine Character
    state Alive {
        %% region movement
        Standing
        Walking
        Jumping
        Crouching
        [*] --> Standing
        Standing --> Walking : Event#58;#58;Move
        Standing --> Jumping : Event#58;#58;Jump
        Standing --> Crouching : Event#58;#58;Crouch
        Walking --> Standing : Event#58;#58;Stop
        Walking --> Jumping : Event#58;#58;Jump
        Walking --> Crouching : Event#58;#58;Crouch
        Jumping --> Standing : Event#58;#58;Land [timer]
        Crouching --> Standing : Event#58;#58;Stand
        --
        %% region weapon
        Ready
        Firing
        Reloading
        Empty
        [*] --> Ready
        Ready --> Firing : Event#58;#58;Fire
        Ready --> Reloading : Event#58;#58;ReloadRequest
        Firing --> Empty : Event#58;#58;CooldownElapsed [timer]
        Firing --> Ready : Event#58;#58;CooldownElapsed [timer]
        Reloading --> Ready : Event#58;#58;ReloadDone [timer]
        Empty --> Reloading : Event#58;#58;ReloadRequest
        --
        %% region anim
        Idle
        Run
        Jump
        Shoot
        [*] --> Idle
        Idle --> Run : Anim#58;#58;Run
        Idle --> Jump : Anim#58;#58;Jump
        Idle --> Shoot : Anim#58;#58;Shoot
        Run --> Idle : Anim#58;#58;Idle
        Run --> Jump : Anim#58;#58;Jump
        Run --> Shoot : Anim#58;#58;Shoot
        Jump --> Idle : Anim#58;#58;Idle
        Jump --> Run : Anim#58;#58;Run
        Jump --> Shoot : Anim#58;#58;Shoot
        Shoot --> Idle : Anim#58;#58;Idle
        Shoot --> Run : Anim#58;#58;Run
        Shoot --> Jump : Anim#58;#58;Jump
    }
    Dead
    [*] --> Alive
    Alive --> Dead : Event#58;#58;Damage
    Dead --> Alive : Event#58;#58;Respawn
